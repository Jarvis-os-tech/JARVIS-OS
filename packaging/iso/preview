#!/usr/bin/env bash
set -euo pipefail
umask 077
dist=$(cd "$(dirname "$0")/../dist" && pwd)
iso=${1:-"$dist/jarvis-voice-os-x86_64.iso"}
test -r "$iso"
disk=${VOICE_OS_HOME_DISK:-"$dist/voice-os-home.raw"}
if [[ ! -e "$disk" ]]; then
    new=$(mktemp "$dist/.voice-home.XXXXXX")
    truncate -s 2G "$new"
    mkfs.ext4 -q -F -L JARVIS_HOME "$new"
    ln "$new" "$disk"
    unlink "$new"
fi
m="$dist/vm/host-modules/usr/lib"
export QEMU_MODULE_DIR="$m/qemu" LD_LIBRARY_PATH="$m"
serial=()
if [[ -n "${VOICE_OS_SERIAL_SOCKET:-}" ]]; then serial=(-serial "unix:$VOICE_OS_SERIAL_SOCKET,server=on,wait=off"); fi
exec qemu-system-x86_64 -name 'JARVIS Voice OS Setup' -machine q35,accel=kvm -cpu host -m 2048 -smp 2 \
    -bios /usr/share/edk2/x64/OVMF.4m.fd -cdrom "$iso" -boot d \
    -drive "file=$disk,format=raw,if=virtio" -vga none -device virtio-vga-gl -display sdl,gl=on \
    -nic user,model=virtio-net-pci -audiodev pipewire,id=snd -device intel-hda -device hda-duplex,audiodev=snd \
    -device qemu-xhci -device usb-tablet "${serial[@]}" -monitor none
