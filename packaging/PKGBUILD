# Maintainer: g0pi <jarvis-os@archlinux.local>
pkgname=jarvis-desktop-environment
pkgver=1.0.0
pkgrel=10
pkgdesc="JARVIS voice-first desktop session for Hyprland"
arch=('x86_64')
license=('MIT' 'Apache-2.0' 'CC-BY-4.0')
depends=('omarchy' 'hyprland' 'hyprlock' 'quickshell' 'python' 'pipewire' 'pipewire-pulse' 'wireplumber'
         'brightnessctl' 'networkmanager' 'xdg-terminal-exec' 'foot'
         'xdg-desktop-portal-hyprland' 'xorg-xwayland' 'polkit')
source=('jarvis-de-session.tar.gz' 'jarvis-de' 'jarvis-de.desktop')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/jarvis-de" "$pkgdir/usr/bin/jarvis-de"
    install -Dm644 "$srcdir/jarvis-de.desktop"         "$pkgdir/usr/share/wayland-sessions/jarvis-de.desktop"

    local root="$pkgdir/usr/lib/jarvis-de"
    install -Dm644 "$srcdir/session/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -d "$root"
    cp -R --preserve=mode,timestamps "$srcdir/session/." "$root/"
    install -Dm644 "$root/ATTRIBUTION.md"         "$pkgdir/usr/share/licenses/$pkgname/ATTRIBUTION.md"
}
