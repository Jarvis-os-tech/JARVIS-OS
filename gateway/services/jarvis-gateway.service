[Unit]
Description=JARVIS-OS Python Gateway (Telegram + Heartbeat + Health)
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/g0pi/Projects/Jarvis-OS/.venv/bin/python /home/g0pi/Projects/Jarvis-OS/brain/gateway.py
WorkingDirectory=/home/g0pi/Projects/Jarvis-OS
EnvironmentFile=-/home/g0pi/Projects/Jarvis-OS/.env
Environment="PATH=/home/g0pi/Projects/Jarvis-OS/.venv/bin:/home/g0pi/.local/bin:/home/g0pi/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/g0pi"
Restart=always
RestartSec=5
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
Alias=friday-gateway.service
