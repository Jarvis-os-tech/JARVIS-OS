[Unit]
Description=JARVIS OS Bridge — DBus, udev, journal, and inotify event reactor
After=jarvis-voice.service dbus.service pipewire.service
Wants=jarvis-voice.service

[Service]
WorkingDirectory=%h/.local/share/jarvis-runtime/current
ExecStart=%h/.local/share/jarvis-runtime/venv/bin/python -m jarvis_os_bridge run
Environment=PYTHONPATH=%h/.local/share/jarvis-runtime/current
Environment=XDG_RUNTIME_DIR=%t
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=false

[Install]
WantedBy=default.target
