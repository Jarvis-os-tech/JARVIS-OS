[Unit]
Description=JARVIS Holographic Drone Companion
After=graphical-session.target jarvis-voice.service
PartOf=jarvis-voice.service
BindsTo=jarvis-voice.service

[Service]
Type=simple
WorkingDirectory=/home/g0pi/JARVIS OS/ui/jarvis_drone
ExecStart="/home/g0pi/JARVIS OS/ui/jarvis_drone/launch.sh"
Restart=on-failure
RestartSec=2
SuccessExitStatus=0 133 143 1
StandardOutput=journal
StandardError=journal
Environment=DISPLAY=:0
Environment=XDG_CURRENT_DESKTOP=Hyprland

[Install]
Alias=jarvis-drone.service
WantedBy=default.target graphical-session.target jarvis-voice.service
